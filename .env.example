# Database Configuration
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nvidia_crawler
DB_USER=postgres
DB_PASSWORD=password

# Twitter API (optional)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# OpenAI API
OPENAI_API_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# DeepSeek API
DEEPSEEK_API_KEY=

# Proxy Configuration (optional)
PROXY_ENABLED=false
PROXY_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log

# Storage
ARCHIVE_ENABLED=true
ARCHIVE_PATH=./output/
OUTPUT_FORMAT=json

# Crawl4AI Settings
CRAWL4AI_TIMEOUT=30
CRAWL4AI_MAX_WORKERS=3
